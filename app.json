{
  "expo": {
    "name": "MentorForge",
    "slug": "MentorForge-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mentorforge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mentorforge.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "6",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Add your study sessions to your calendar",
        "NSCalendarsFullAccessUsageDescription": "Add your study sessions to your calendar",
        "CFBundleDisplayName": "MentorForge",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F8F6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mentorforge.app",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F8F6"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#4A5D4E"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "MentorForge adds your study sessions to your calendar."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.497007232019-dh5pgdu54gfa91qq0ss7vb5b9l58s8ot"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7947e132-5b5f-4e08-812c-21dedd501f70"
      }
    },
    "owner": "third-space-atlas"
  }
}
