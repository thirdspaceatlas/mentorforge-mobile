# Copy to .env for local development (EXPO_PUBLIC_* are bundled into the app).
EXPO_PUBLIC_API_URL=https://www.mentorforge.co
EXPO_PUBLIC_SUPABASE_URL=https://dgooxbxnyaoallvwdsxq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web OAuth client ID — required for Google Sign-In idToken on Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# iOS reversed client ID for the Google Sign-In config plugin.
# Example: com.googleusercontent.apps.497007232019-xxxxxxxx
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.497007232019-your-ios-client-suffix
